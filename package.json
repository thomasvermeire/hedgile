{
  "name": "hedgile",
  "version": "0.1.0",
  "description": "Hedgile helps small trading teams manage nickel trades from contract to final invoice, giving them a clear view of their daily positions and valuations.",
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "dev": "vitest watch"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "trading",
    "nickel",
    "commodities",
    "portfolio",
    "valuation"
  ],
  "author": "",
  "license": "ISC"
}
