# Example settings with safe values. For local development copy this file to .dev.vars
# (git-ignored), which `pnpm dev` and `wrangler dev` read.
# In production, set secrets in the Cloudflare dashboard (Worker > Settings > Variables and Secrets)
# or with `pnpm exec wrangler secret put NAME`.
APP_ENV=development
LOG_LEVEL=debug

# Signs the session cookie: at least 32 random characters (openssl rand -hex 32).
SESSION_SECRET=0123456789abcdef0123456789abcdef

# The first admin: signing in with exactly this email and password creates them as
# admin of organisation Hedgile. Remove both once that account exists.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Laimon panel (chat and PDF extraction). Leave empty to switch the panel off.
ANTHROPIC_API_KEY=
